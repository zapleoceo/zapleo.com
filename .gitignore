# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.swp
Thumbs.db

# legacy archive (research dump, не должно попадать в репо)
/.archive/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify — commit graph.json + GRAPH_REPORT.md, skip machine-specific / transient files
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/cache/
graphify-out/.graphify_*.json
graphify-out/graph.html
